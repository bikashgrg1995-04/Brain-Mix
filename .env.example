# Multiplayer (Supabase Realtime). `.env.local` ma copy garera afno project ko value halnus.
# Supabase dashboard > Project Settings > API. Anon key public ho (browser ma jancha), service_role key kahile nahalne.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
